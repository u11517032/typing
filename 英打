<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>English Typing Master - Target Shooting Edition</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
    <style>
        :root {
            --vintage-bg: #2a221b;
            --vintage-border: #d4af37;
            --neon-gold: #ffcc00;
            --neon-red: #ff3333;
            --neon-green: #33ff33;
            --neon-blue: #00e5ff;
            --crt-bg: #0d1117;
            --panel-bg: #1c1510;
        }

        * {
            box-sizing: border-box;
            user-select: none;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: #120e0b;
            color: #f0e6d2;
            font-family: 'VT323', monospace;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            overflow: hidden;
        }

        /* Arcade Frame / CRT Box */
        #game-container {
            width: 1000px;
            height: 680px;
            background-color: var(--crt-bg);
            border: 12px solid #3a2e25;
            border-radius: 20px;
            box-shadow: 0 0 30px rgba(0,0,0,0.9), inset 0 0 20px rgba(0,0,0,0.8);
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        /* CRT Scanline Effect */
        #game-container::before {
            content: " ";
            display: block;
            position: absolute;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            z-index: 100;
            background-size: 100% 4px, 6px 100%;
            pointer-events: none;
        }

        /* Screen States */
        .screen {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            background: radial-gradient(circle, #2c2219 0%, #100b08 100%);
        }

        .screen.active {
            opacity: 1;
            pointer-events: auto;
        }

        /* Buttons & UI Elements */
        .arcade-btn {
            background: linear-gradient(180deg, #e65c00 0%, #993d00 100%);
            border: 3px solid var(--vintage-border);
            color: #fff;
            padding: 12px 24px;
            font-family: 'Press Start 2P', cursive;
            font-size: 14px;
            cursor: pointer;
            border-radius: 8px;
            text-shadow: 2px 2px #000;
            box-shadow: 0 5px 0 #4d1f00, 0 10px 15px rgba(0,0,0,0.5);
            transition: all 0.1s ease;
            margin: 10px;
        }

        .arcade-btn:hover {
            background: linear-gradient(180deg, #ff701a 0%, #b34700 100%);
            transform: translateY(-2px);
            box-shadow: 0 7px 0 #4d1f00, 0 12px 18px rgba(0,0,0,0.6);
        }

        .arcade-btn:active {
            transform: translateY(4px);
            box-shadow: 0 1px 0 #4d1f00, 0 5px 10px rgba(0,0,0,0.5);
        }

        /* MAIN MENU SCREEN */
        .title-banner {
            text-align: center;
            border: 4px double var(--vintage-border);
            padding: 15px 30px;
            background: rgba(0,0,0,0.6);
            border-radius: 12px;
            margin-bottom: 20px;
            box-shadow: 0 0 15px var(--neon-gold);
        }

        .title-banner h1 {
            font-family: 'Press Start 2P', cursive;
            font-size: 26px;
            color: var(--neon-gold);
            text-shadow: 3px 3px var(--neon-red);
            letter-spacing: 2px;
            margin-bottom: 10px;
        }

        .title-banner h2 {
            font-size: 20px;
            color: var(--neon-blue);
            letter-spacing: 4px;
        }

        .main-layout {
            display: flex;
            width: 90%;
            justify-content: space-between;
            align-items: center;
            margin-top: 10px;
        }

        .left-preview {
            width: 48%;
            height: 280px;
            border: 3px solid var(--vintage-border);
            background: #000;
            border-radius: 10px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            position: relative;
            box-shadow: inset 0 0 20px rgba(255, 204, 0, 0.2);
        }

        .right-settings {
            width: 48%;
            height: 280px;
            border: 3px solid var(--vintage-border);
            background: var(--panel-bg);
            border-radius: 10px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-around;
        }

        .setting-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 22px;
            color: #fff;
            border-bottom: 1px dashed #443322;
            padding-bottom: 8px;
        }

        .setting-row select, .setting-row input[type="checkbox"] {
            transform: scale(1.3);
            cursor: pointer;
        }

        .setting-row select {
            background: #000;
            color: var(--neon-gold);
            border: 1px solid var(--vintage-border);
            font-family: 'VT323', monospace;
            font-size: 20px;
            padding: 2px 8px;
        }

        /* LEVEL SELECT SCREEN */
        .level-grid {
            display: flex;
            gap: 20px;
            margin-top: 30px;
        }

        .level-card {
            width: 260px;
            height: 320px;
            border: 3px solid var(--vintage-border);
            background: rgba(20, 15, 10, 0.9);
            border-radius: 12px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: space-between;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
        }

        .level-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 0 20px var(--neon-gold);
            border-color: #fff;
        }

        .level-card h3 {
            font-family: 'Press Start 2P', cursive;
            font-size: 16px;
            color: var(--neon-gold);
        }

        .level-card p {
            font-size: 18px;
            color: #ccc;
            line-height: 1.4;
        }

        /* GAMEPLAY HUD */
        .hud {
            width: 100%;
            height: 60px;
            background: rgba(0,0,0,0.8);
            border-bottom: 2px solid var(--vintage-border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 20px;
            font-size: 24px;
            color: var(--neon-gold);
            z-index: 10;
        }

        .hud-val {
            color: #fff;
            font-family: 'Press Start 2P', cursive;
            font-size: 16px;
        }

        /* GAMEPLAY AREA */
        .game-viewport {
            flex: 1;
            width: 100%;
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: radial-gradient(ellipse at center, #221a14 0%, #080604 100%);
        }

        /* TARGET LANES */
        .target-container {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 15px;
            margin-bottom: 20px;
            min-height: 220px;
            width: 100%;
            padding: 0 20px;
        }

        .target-wrapper {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            transition: transform 0.3s;
        }

        .target-board {
            width: 110px;
            height: 110px;
            border-radius: 50%;
            background: radial-gradient(circle, #ff0000 0%, #ff0000 20%, #ffffff 20%, #ffffff 40%, #ff0000 40%, #ff0000 60%, #ffffff 60%, #ffffff 80%, #111 80%);
            border: 4px solid #333;
            display: flex;
            justify-content: center;
            align-items: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.6);
            position: relative;
            opacity: 0.4;
            transform: scale(0.9);
            transition: all 0.2s ease;
        }

        .target-board.active {
            opacity: 1;
            transform: scale(1.1);
            box-shadow: 0 0 25px var(--neon-gold), inset 0 0 10px #fff;
            border-color: var(--neon-gold);
        }

        .target-board.completed {
            opacity: 0.25;
            filter: grayscale(100%);
        }

        .target-char {
            font-family: 'Press Start 2P', cursive;
            font-size: 32px;
            color: #000;
            text-shadow: 0 0 5px #fff;
            z-index: 2;
        }

        .target-board.active .target-char {
            color: #000;
            animation: pulse-char 0.8s infinite alternate;
        }

        @keyframes pulse-char {
            0% { transform: scale(1); }
            100% { transform: scale(1.2); }
        }

        /* SVG DART ANIMATION LAYER */
        .dart-svg {
            position: absolute;
            width: 60px;
            height: 20px;
            z-index: 50;
            pointer-events: none;
            transition: all 0.12s linear;
        }

        /* VIRTUAL KEYBOARD */
        .keyboard-container {
            width: 780px;
            background: #18130e;
            border: 3px solid var(--vintage-border);
            border-radius: 10px;
            padding: 12px;
            box-shadow: 0 0 20px rgba(0,0,0,0.8);
            margin-bottom: 10px;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .kb-row {
